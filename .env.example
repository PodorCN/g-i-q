# Optional, for local CLI semantic extraction only. Never commit .env or .dev.vars.
# The production Worker uses its native Workers AI binding, without an API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
BLS_API_KEY=

# Optional: upload a locally collected snapshot to an already deployed backend.
GIQ_API_URL=https://giq-api.YOUR-SUBDOMAIN.workers.dev
GIQ_ADMIN_TOKEN=

# Set these securely in your terminal / Cloudflare / GitHub Actions settings.
# Do not paste secrets into chat or commit them.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
